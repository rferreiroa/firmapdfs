# =============================================================================
# FirmaPDFs - Git Ignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# MyPy
.mypy_cache/

# Documentation
docs/_build/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Project Specific
# ------------------

# Processed files (generated)
processed/docx/*
processed/pdf/*
processed/signed/*
processed/archive/*
!processed/docx/.gitkeep
!processed/pdf/.gitkeep
!processed/signed/.gitkeep

# Logs
logs/*.log
logs/report.csv
logs/report.html
!logs/.gitkeep

# Input files (user data)
samples/inbox/*
!samples/inbox/.gitkeep

# Certificates (NEVER commit these!)
config/*.pfx
config/*.p12
config/*.pem
config/*.key
config/*.cer
config/*.crt

# Credentials
.env
.env.local
*.env

# Temporary files
~$*
*.tmp
*.temp
*.bak

# Word temp files
~$*.docx
~$*.doc
